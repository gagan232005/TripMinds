PORT=5101

# ---- Real AI (optional but recommended) ----
# Without a key, TripMinds runs on its deterministic local pipeline
# (regex NLP + heuristic agent scoring) — fully working demo.
# With a key, an LLM genuinely reads chat messages, chooses among
# shortlisted agent options, and personalizes the itinerary.
# Budget math always stays deterministic (never LLM arithmetic).
#
# Get a key: https://platform.openai.com/api-keys (needs API credits;
# gpt-4o-mini costs cents per hundred trips). Any OpenAI-compatible
# endpoint also works (OpenRouter, Together, local Ollama, ...).
#
# Steps:
#   1. Copy this file to `.env`
#   2. Fill in LLM_API_KEY (and optionally LLM_MODEL / LLM_BASE_URL)
#   3. Restart the server (`npm run dev`)
#
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
